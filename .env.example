# Copy to .env and adjust before starting the stack.

# Change this to a long random string before exposing the app.
SECRET_KEY=please-change-this-secret-key-in-production

# simulate = generate demo punch data, live = read the physical device
DEVICE_MODE=simulate

# Your eSSL / ZKTeco biometric device
DEVICE_IP=192.168.20.90
DEVICE_PORT=4370
DEVICE_TIMEOUT=5

# Background punch sync (minutes)
DEVICE_SYNC_INTERVAL_MINUTES=10

# Automatically create employees for new device enrolment IDs
AUTO_CREATE_DEVICE_USERS=true

DEFAULT_SHIFT_NAME=General Shift
